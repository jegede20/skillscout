# --- Supabase (optional: leave blank to run in demo mode with browser-local accounts) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (optional: without it, roadmaps use the verified template) ---
GROQ_API_KEY=
# Optional: model id for AI roadmaps. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# --- Analytics (optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown as the "learners" stat on the landing page. Leave blank to show "Be the first" instead.
NEXT_PUBLIC_LEARNER_COUNT=
